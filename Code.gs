/**
 * CONSILIUM APPLICATION + APPOINTMENT REQUEST SYSTEM
 *
 * Deploy as a Google Apps Script Web App:
 *   Execute as: Me
 *   Who has access: Anyone
 *
 * Project timezone: Africa/Casablanca
 *
 * Applications are stored in a private Google Spreadsheet.
 * Appointment requests are created as PENDING Google Calendar events so
 * concurrent applicants cannot request the same time. They are only renamed
 * to CONFIRMED after Consilium accepts them from the admin spreadsheet.
 */

const DESTINATION_EMAIL = 'consilium.consultinghq@gmail.com';
const BRAND = 'CONSILIUM';
const TZ = 'Africa/Casablanca';
const DAILY_LIMIT = 9;
const SLOT_MINUTES = 45;
const OPEN_HOUR = 9;
const CLOSE_HOUR = 19;
const EVENT_PREFIX = 'CONSILIUM REQUEST — PENDING';
const CONFIRMED_PREFIX = 'CONSILIUM — CONFIRMED';
const SHEET_NAME = 'Applications';
const ADMIN_SPREADSHEET_PROPERTY = 'CONSILIUM_ADMIN_SPREADSHEET_ID';

const HEADERS = [
  'Application Reference',
  'Status',
  'Submitted At',
  'Full Name',
  'Email',
  'Phone',
  'Country',
  'City',
  'Applicant Type',
  'Industry / Market',
  'Website / LinkedIn',
  'Objectives',
  'Working Towards',
  'Additional Context',
  'Ability To Accept Change',
  'Appointment Date',
  'Appointment Time',
  'Appointment Status',
  'Calendar Event ID',
  'Admin Notes',
  'Email Status',
  'Submission Nonce'
];

function doGet(e) {
  const p = (e && e.parameter) || {};
  if (String(p.action || '') === 'availability') {
    const result = availability_(String(p.date || ''));
    const callback = String(p.callback || '');
    if (/^consiliumCb[0-9]+$/.test(callback)) {
      return ContentService
        .createTextOutput(callback + '(' + JSON.stringify(result) + ');')
        .setMimeType(ContentService.MimeType.JAVASCRIPT);
    }
    return json_(result);
  }
  return json_({
    ok: true,
    service: 'Consilium scheduling endpoint',
    timezone: TZ
  });
}

function doPost(e) {
  let nonce = '';
  let rowNumber = 0;
  try {
    const p = (e && e.parameters) || {};
    nonce = clean_(first_(p.submission_nonce), 120);

    // Honeypot: silently accept bot submissions without processing them.
    if (clean_(first_(p.website), 200)) {
      return responsePage_(true, nonce, 'IGNORED');
    }

    const required = [
      'name',
      'email',
      'phone',
      'country',
      'city',
      'applicant_type',
      'working_toward',
      'ability_to_accept_change',
      'appointment_date',
      'appointment_time',
      'submission_nonce'
    ];

    for (const key of required) {
      if (!clean_(first_(p[key]), 5000)) {
        return responsePage_(false, nonce, 'Please complete all required fields.');
      }
    }

    const name = clean_(first_(p.name), 120);
    const email = clean_(first_(p.email), 200).toLowerCase();
    const phone = clean_(first_(p.phone), 80);
    const country = clean_(first_(p.country), 120);
    const city = clean_(first_(p.city), 120);
    const applicantType = clean_(first_(p.applicant_type), 120);
    const industry = clean_(first_(p.industry_market), 160);
    const referenceUrl = clean_(first_(p.reference_url), 500);
    const workingTowards = clean_(first_(p.working_toward), 5000);
    const additionalContext = clean_(first_(p.additional_context), 3000);
    const ability = clean_(first_(p.ability_to_accept_change), 30);
    const appointmentDate = clean_(first_(p.appointment_date), 20);
    const appointmentTime = clean_(first_(p.appointment_time), 10);
    const objectives = clean_(values_(p['objectives[]']).join(', '), 1500);

    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      return responsePage_(false, nonce, 'Please enter a valid email address.');
    }
    if (referenceUrl && !/^https?:\/\/\S+$/i.test(referenceUrl)) {
      return responsePage_(false, nonce, 'Please enter a valid website or LinkedIn URL.');
    }
    if (!/^(?:[1-9]|10)$/.test(ability)) {
      return responsePage_(false, nonce, 'Please select a valid change rating.');
    }
    if (!/^\d{4}-\d{2}-\d{2}$/.test(appointmentDate) ||
        !/^\d{2}:\d{2}$/.test(appointmentTime)) {
      return responsePage_(false, nonce, 'Invalid appointment date or time.');
    }
    if (!isAllowedSlot_(appointmentTime)) {
      return responsePage_(false, nonce, 'Please select one of the available appointment times.');
    }

    const lock = LockService.getScriptLock();
    lock.waitLock(20000);

    let sheet;
    let event = null;
    try {
      sheet = getApplicationSheet_();

      // Nonce is generated by the browser and stored server-side. A replay
      // of the same submission is rejected as a duplicate.
      if (findRowByValue_(sheet, 22, nonce)) {
        return responsePage_(false, nonce, 'This application has already been submitted. Please do not submit it again.');
      }

      const start = parseSlot_(appointmentDate, appointmentTime);
      const end = new Date(start.getTime() + SLOT_MINUTES * 60000);
      const now = new Date();

      if (start <= now) {
        return responsePage_(false, nonce, 'That appointment time has passed. Please choose another.');
      }

      // Keep all validation and booking checks inside the lock so two
      // simultaneous applicants cannot reserve the same slot.
      const dailyRequests = countRequestsForDate_(sheet, appointmentDate);
      if (dailyRequests >= DAILY_LIMIT) {
        return responsePage_(false, nonce, 'This date has reached the daily request limit. Please choose another date.');
      }

      const cal = CalendarApp.getDefaultCalendar();
      const dayStart = parseSlot_(appointmentDate, '00:00');
      const dayEnd = new Date(dayStart.getTime() + 24 * 60 * 60000);
      const events = cal.getEvents(dayStart, dayEnd);

      const conflict = events.some(function(ev) {
        return ev.isAllDayEvent() ||
          (ev.getStartTime() < end && ev.getEndTime() > start);
      });

      if (conflict) {
        return responsePage_(false, nonce, 'That time is no longer available. Please choose another time.');
      }

      const reference = createApplicationReference_();
      const submittedAt = new Date();

      const row = [
        reference,
        'PENDING',
        submittedAt,
        name,
        email,
        phone,
        country,
        city,
        applicantType,
        industry,
        referenceUrl,
        objectives,
        workingTowards,
        additionalContext,
        ability,
        appointmentDate,
        appointmentTime,
        'PENDING',
        '',
        '',
        'NOT SENT',
        nonce
      ];

      // Save the application before any notification email is sent.
      sheet.appendRow(row);
      rowNumber = sheet.getLastRow();

      try {
        const description = buildCalendarDescription_({
          reference: reference,
          name: name,
          email: email,
          phone: phone,
          country: country,
          city: city,
          applicantType: applicantType,
          industry: industry,
          referenceUrl: referenceUrl,
          objectives: objectives,
          workingTowards: workingTowards,
          additionalContext: additionalContext,
          ability: ability,
          appointmentDate: appointmentDate,
          appointmentTime: appointmentTime
        });

        event = cal.createEvent(
          EVENT_PREFIX + ' — ' + name + ' — ' + reference,
          start,
          end,
          { description: description }
        );
        event.setColor(CalendarApp.EventColor.GRAY);

        sheet.getRange(rowNumber, 19).setValue(event.getId());
        sheet.getRange(rowNumber, 18).setValue('PENDING');
      } catch (calendarError) {
        sheet.getRange(rowNumber, 2).setValue('ERROR');
        sheet.getRange(rowNumber, 18).setValue('CALENDAR ERROR');
        sheet.getRange(rowNumber, 20).setValue(clean_(calendarError.message, 500));
        sheet.getRange(rowNumber, 21).setValue('NOT SENT');
        console.error(calendarError);
        return responsePage_(false, nonce, 'Your application could not be completed because the requested appointment could not be reserved. Please try again.');
      }

      const adminBody = buildAdminEmail_({
        reference: reference,
        submittedAt: submittedAt,
        name: name,
        email: email,
        phone: phone,
        country: country,
        city: city,
        applicantType: applicantType,
        industry: industry,
        referenceUrl: referenceUrl,
        objectives: objectives,
        workingTowards: workingTowards,
        additionalContext: additionalContext,
        ability: ability,
        appointmentDate: appointmentDate,
        appointmentTime: appointmentTime,
        eventId: event.getId()
      });

      const applicantBody = buildApplicantReceivedEmail_(name);

      let adminSent = false;
      let applicantSent = false;
      let emailError = '';

      try {
        MailApp.sendEmail({
          to: DESTINATION_EMAIL,
          subject: 'New Consilium application — ' + name + ' — ' + reference,
          body: adminBody,
          replyTo: email,
          name: BRAND + ' Applications'
        });
        adminSent = true;
      } catch (mailError) {
        emailError = 'Consilium notification failed: ' + clean_(mailError.message, 500);
        console.error(mailError);
      }

      try {
        MailApp.sendEmail({
          to: email,
          subject: 'Your Consilium Application — Received',
          body: applicantBody,
          name: BRAND
        });
        applicantSent = true;
      } catch (mailError) {
        emailError += (emailError ? ' | ' : '') +
          'Applicant notification failed: ' + clean_(mailError.message, 500);
        console.error(mailError);
      }

      const emailStatus = adminSent && applicantSent
        ? 'SENT'
        : 'ERROR — ' + emailError;

      sheet.getRange(rowNumber, 21).setValue(emailStatus);

      // The application and appointment request are already saved at this
      // point. Email failures are recorded for the administrator but must not
      // cause the applicant to resubmit and create a duplicate request.
      if (!adminSent || !applicantSent) {
        return responsePage_(
          true,
          nonce,
          'Your application was saved, but one or more notification emails could not be sent.',
          reference
        );
      }

      return responsePage_(true, nonce, '', reference);
    } finally {
      lock.releaseLock();
    }
  } catch (err) {
    console.error(err);
    if (rowNumber) {
      try {
        const sheet = getApplicationSheet_();
        sheet.getRange(rowNumber, 2).setValue('ERROR');
        sheet.getRange(rowNumber, 20).setValue(clean_(err.message, 500));
      } catch (ignored) {
        console.error(ignored);
      }
    }
    return responsePage_(false, nonce, 'Unable to process the application. Please try again later.');
  }
}

/**
 * Returns appointment slots for the requested Casablanca date.
 * The frontend calls this through JSONP because the public static site and
 * Apps Script web app are different origins.
 */
function availability_(dateText) {
  try {
    if (!/^\d{4}-\d{2}-\d{2}$/.test(dateText)) {
      return { ok: false, error: 'Invalid date.' };
    }

    const dayStart = parseSlot_(dateText, '00:00');
    const todayStart = parseSlot_(
      Utilities.formatDate(new Date(), TZ, 'yyyy-MM-dd'),
      '00:00'
    );

    if (dayStart < todayStart) {
      return { ok: true, slots: [], dailyLimitReached: false };
    }

    const sheet = getApplicationSheet_();
    const dailyRequests = countRequestsForDate_(sheet, dateText);
    if (dailyRequests >= DAILY_LIMIT) {
      return { ok: true, slots: [], dailyLimitReached: true };
    }

    const cal = CalendarApp.getDefaultCalendar();
    const dayEnd = new Date(dayStart.getTime() + 24 * 60 * 60000);
    const events = cal.getEvents(dayStart, dayEnd);
    const slots = [];
    const now = new Date();

    for (let minutes = OPEN_HOUR * 60;
         minutes + SLOT_MINUTES <= CLOSE_HOUR * 60;
         minutes += SLOT_MINUTES) {
      const hh = Math.floor(minutes / 60);
      const mm = minutes % 60;
      const timeText = pad2_(hh) + ':' + pad2_(mm);
      const start = parseSlot_(dateText, timeText);
      const end = new Date(start.getTime() + SLOT_MINUTES * 60000);

      if (start <= now) continue;

      const conflict = events.some(function(ev) {
        return ev.isAllDayEvent() ||
          (ev.getStartTime() < end && ev.getEndTime() > start);
      });

      if (!conflict) slots.push(timeText);
    }

    return {
      ok: true,
      slots: slots,
      dailyLimitReached: false,
      timezone: TZ,
      durationMinutes: SLOT_MINUTES
    };
  } catch (err) {
    console.error(err);
    return { ok: false, error: 'Could not check availability.' };
  }
}

/**
 * Creates the private admin spreadsheet on first setup/use.
 * Run setupConsilium() once manually from the Apps Script editor so the
 * administrator receives the spreadsheet URL and can use the admin menu.
 */
function setupConsilium() {
  const sheet = getApplicationSheet_();
  const spreadsheet = sheet.getParent();
  spreadsheet.setSpreadsheetTimeZone(TZ);
  ensureHeaders_(sheet);
  sheet.setFrozenRows(1);
  sheet.getRange(1, 1, 1, HEADERS.length).setFontWeight('bold');
  sheet.autoResizeColumns(1, HEADERS.length);
  installSpreadsheetTrigger_(spreadsheet);

  Logger.log('Consilium admin spreadsheet: ' + spreadsheet.getUrl());
  return spreadsheet.getUrl();
}

function installSpreadsheetTrigger_(spreadsheet) {
  const triggers = ScriptApp.getProjectTriggers();
  const alreadyInstalled = triggers.some(function(trigger) {
    return trigger.getHandlerFunction() === 'onOpen' &&
      trigger.getTriggerSourceId() === spreadsheet.getId();
  });
  if (!alreadyInstalled) {
    ScriptApp.newTrigger('onOpen')
      .forSpreadsheet(spreadsheet)
      .onOpen()
      .create();
  }
}

function onOpen(e) {
  SpreadsheetApp.getUi()
    .createMenu('Consilium Admin')
    .addItem('Accept selected application', 'acceptSelectedApplication')
    .addItem('Decline selected application', 'declineSelectedApplication')
    .addSeparator()
    .addItem('Refresh / setup sheet', 'setupConsilium')
    .addToUi();
}

function acceptSelectedApplication() {
  const sheet = getActiveApplicationSheet_();
  const row = getSelectedApplicationRow_(sheet);
  if (!row) return;

  const lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    const values = sheet.getRange(row, 1, 1, HEADERS.length).getValues()[0];
    const status = String(values[1] || '').trim();
    const appointmentStatus = String(values[17] || '').trim();
    const eventId = String(values[18] || '').trim();

    if (status !== 'PENDING' || appointmentStatus !== 'PENDING') {
      throw new Error('Only a pending application can be accepted.');
    }
    if (!eventId) throw new Error('This application has no calendar event.');

    const email = String(values[4] || '').trim();
    const name = String(values[3] || '').trim();
    const reference = String(values[0] || '').trim();
    const appointmentDate = String(values[15] || '').trim();
    const appointmentTime = String(values[16] || '').trim();

    const event = CalendarApp.getDefaultCalendar().getEventById(eventId);
    if (!event) throw new Error('The pending calendar event could not be found.');

    // Re-check conflict before accepting, excluding the event itself.
    const start = event.getStartTime();
    const end = event.getEndTime();
    const conflicts = CalendarApp.getDefaultCalendar()
      .getEvents(start, end)
      .some(function(ev) {
        return ev.getId() !== eventId &&
          (ev.isAllDayEvent() || (ev.getStartTime() < end && ev.getEndTime() > start));
      });
    if (conflicts) throw new Error('The requested time now conflicts with another calendar event.');

    event.setTitle(CONFIRMED_PREFIX + ' — ' + name + ' — ' + reference);
    event.setColor(CalendarApp.EventColor.GREEN);
    event.setDescription(event.getDescription() +
      '\n\nSTATUS UPDATED: CONFIRMED BY CONSILIUM');

    sheet.getRange(row, 2).setValue('ACCEPTED');
    sheet.getRange(row, 18).setValue('CONFIRMED');
    sheet.getRange(row, 20).setValue('Accepted by Consilium on ' + formatNow_());

    try {
      MailApp.sendEmail({
        to: email,
        subject: 'Your Consilium Appointment — Confirmed',
        body: buildDecisionEmail_(name, reference, appointmentDate, appointmentTime, true),
        name: BRAND
      });
      sheet.getRange(row, 21).setValue('SENT — ACCEPTANCE');
    } catch (mailError) {
      sheet.getRange(row, 21).setValue('ERROR — Acceptance email failed: ' + clean_(mailError.message, 500));
      throw new Error('Appointment accepted and added to Google Calendar, but the applicant email failed: ' + mailError.message);
    }
  } finally {
    lock.releaseLock();
  }
}

function declineSelectedApplication() {
  const sheet = getActiveApplicationSheet_();
  const row = getSelectedApplicationRow_(sheet);
  if (!row) return;

  const ui = SpreadsheetApp.getUi();
  const answer = ui.alert(
    'Decline appointment request',
    'Decline the selected appointment request?',
    ui.ButtonSet.YES_NO
  );
  if (answer !== ui.Button.YES) return;

  const lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    const values = sheet.getRange(row, 1, 1, HEADERS.length).getValues()[0];
    const status = String(values[1] || '').trim();
    const appointmentStatus = String(values[17] || '').trim();
    const eventId = String(values[18] || '').trim();

    if (status !== 'PENDING' || appointmentStatus !== 'PENDING') {
      throw new Error('Only a pending application can be declined.');
    }

    const email = String(values[4] || '').trim();
    const name = String(values[3] || '').trim();
    const reference = String(values[0] || '').trim();
    const appointmentDate = String(values[15] || '').trim();
    const appointmentTime = String(values[16] || '').trim();

    if (eventId) {
      const event = CalendarApp.getDefaultCalendar().getEventById(eventId);
      if (event) event.deleteEvent();
    }

    sheet.getRange(row, 2).setValue('DECLINED');
    sheet.getRange(row, 18).setValue('DECLINED');
    sheet.getRange(row, 20).setValue('Declined by Consilium on ' + formatNow_());

    try {
      MailApp.sendEmail({
        to: email,
        subject: 'Your Consilium Appointment — Update',
        body: buildDecisionEmail_(name, reference, appointmentDate, appointmentTime, false),
        name: BRAND
      });
      sheet.getRange(row, 21).setValue('SENT — DECLINE');
    } catch (mailError) {
      sheet.getRange(row, 21).setValue('ERROR — Decline email failed: ' + clean_(mailError.message, 500));
      throw new Error('Appointment declined, but the applicant email failed: ' + mailError.message);
    }
  } finally {
    lock.releaseLock();
  }
}

function getApplicationSheet_() {
  const props = PropertiesService.getScriptProperties();
  let spreadsheetId = props.getProperty(ADMIN_SPREADSHEET_PROPERTY);

  if (spreadsheetId) {
    try {
      const spreadsheet = SpreadsheetApp.openById(spreadsheetId);
      const sheet = spreadsheet.getSheetByName(SHEET_NAME) || spreadsheet.insertSheet(SHEET_NAME);
      ensureHeaders_(sheet);
      return sheet;
    } catch (err) {
      console.error(err);
    }
  }

  const spreadsheet = SpreadsheetApp.create('Consilium Applications & Appointment Requests');
  spreadsheet.setSpreadsheetTimeZone(TZ);
  const sheet = spreadsheet.getSheets()[0];
  sheet.setName(SHEET_NAME);
  ensureHeaders_(sheet);
  sheet.setFrozenRows(1);
  sheet.getRange(1, 1, 1, HEADERS.length).setFontWeight('bold');
  props.setProperty(ADMIN_SPREADSHEET_PROPERTY, spreadsheet.getId());
  installSpreadsheetTrigger_(spreadsheet);
  Logger.log('Consilium admin spreadsheet created: ' + spreadsheet.getUrl());
  return sheet;
}

function ensureHeaders_(sheet) {
  const current = sheet.getRange(1, 1, 1, HEADERS.length).getValues()[0];
  const matches = HEADERS.every(function(header, i) {
    return current[i] === header;
  });
  if (!matches) {
    sheet.getRange(1, 1, 1, HEADERS.length).setValues([HEADERS]);
  }
}

function getActiveApplicationSheet_() {
  const spreadsheetId = PropertiesService.getScriptProperties()
    .getProperty(ADMIN_SPREADSHEET_PROPERTY);
  if (!spreadsheetId) {
    throw new Error('Run setupConsilium() first.');
  }
  const spreadsheet = SpreadsheetApp.openById(spreadsheetId);
  const sheet = spreadsheet.getSheetByName(SHEET_NAME);
  if (!sheet) throw new Error('The Consilium Applications sheet was not found.');
  return sheet;
}

function getSelectedApplicationRow_(sheet) {
  const row = sheet.getActiveRange().getRow();
  if (row <= 1) throw new Error('Select an application row first.');
  if (row > sheet.getLastRow()) throw new Error('Select an application row first.');
  return row;
}

function countRequestsForDate_(sheet, dateText) {
  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return 0;

  // Count live requests that reserve capacity. ERROR rows never reserved a
  // slot successfully; DECLINED rows have released their calendar slot.
  const values = sheet.getRange(2, 2, lastRow - 1, 15).getValues();
  let count = 0;
  values.forEach(function(row) {
    const status = String(row[0] || '');
    const appointmentDate = String(row[14] || '');
    if (appointmentDate === dateText && (status === 'PENDING' || status === 'ACCEPTED')) {
      count++;
    }
  });
  return count;
}

function findRowByValue_(sheet, columnNumber, value) {
  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return 0;
  const values = sheet.getRange(2, columnNumber, lastRow - 1, 1).getValues();
  for (let i = 0; i < values.length; i++) {
    if (String(values[i][0] || '') === String(value)) return i + 2;
  }
  return 0;
}

function isAllowedSlot_(timeText) {
  if (!/^\d{2}:\d{2}$/.test(timeText)) return false;
  const parts = timeText.split(':').map(Number);
  const minutes = parts[0] * 60 + parts[1];
  return minutes >= OPEN_HOUR * 60 &&
    minutes + SLOT_MINUTES <= CLOSE_HOUR * 60 &&
    minutes % SLOT_MINUTES === 0;
}

function parseSlot_(dateText, timeText) {
  if (!isAllowedSlot_(timeText) && timeText !== '00:00') {
    throw new Error('Invalid appointment time.');
  }
  const d = Utilities.parseDate(dateText + ' ' + timeText, TZ, 'yyyy-MM-dd HH:mm');
  if (Utilities.formatDate(d, TZ, 'yyyy-MM-dd HH:mm') !== dateText + ' ' + timeText) {
    throw new Error('Invalid Casablanca date or time.');
  }
  return d;
}

function createApplicationReference_() {
  const stamp = Utilities.formatDate(new Date(), TZ, 'yyyyMMdd-HHmmss');
  const random = Utilities.getUuid().replace(/-/g, '').slice(0, 6).toUpperCase();
  return 'CON-' + stamp + '-' + random;
}

function buildCalendarDescription_(a) {
  return [
    'APPLICATION STATUS: PENDING REVIEW',
    'This calendar event is a request, not a confirmed appointment.',
    '',
    'Application reference: ' + a.reference,
    'Full name: ' + a.name,
    'Email: ' + a.email,
    'Phone: ' + a.phone,
    'Country: ' + a.country,
    'City: ' + a.city,
    'Applicant type: ' + a.applicantType,
    'Industry / market: ' + a.industry,
    'Website / LinkedIn: ' + a.referenceUrl,
    'Objectives: ' + a.objectives,
    '',
    'Working towards:',
    a.workingTowards,
    '',
    'Additional context:',
    a.additionalContext,
    '',
    'Ability to accept change: ' + a.ability,
    'Requested appointment: ' + a.appointmentDate + ' at ' + a.appointmentTime + ' (' + TZ + ')'
  ].join('\n');
}

function buildAdminEmail_(a) {
  return [
    'A new Consilium application and appointment request has been received.',
    '',
    'STATUS: PENDING REVIEW — NOT CONFIRMED',
    'APPLICATION REFERENCE: ' + a.reference,
    'SUBMISSION TIMESTAMP: ' + Utilities.formatDate(a.submittedAt, TZ, 'yyyy-MM-dd HH:mm:ss'),
    'REQUESTED APPOINTMENT: ' + a.appointmentDate + ' at ' + a.appointmentTime + ' (' + TZ + ')',
    'CALENDAR EVENT ID: ' + a.eventId,
    '',
    'APPLICANT',
    'Full name: ' + a.name,
    'Email: ' + a.email,
    'Phone: ' + a.phone,
    'Country: ' + a.country,
    'City: ' + a.city,
    'Applicant type: ' + a.applicantType,
    'Industry / market: ' + a.industry,
    'Website / LinkedIn: ' + a.referenceUrl,
    '',
    'OBJECTIVES',
    a.objectives || '(none selected)',
    '',
    'WORKING TOWARDS',
    a.workingTowards,
    '',
    'ADDITIONAL CONTEXT',
    a.additionalContext || '(none)',
    '',
    'ABILITY TO ACCEPT CHANGE',
    a.ability,
    '',
    'Review the application in the private Consilium admin spreadsheet.',
    'Use the "Consilium Admin" menu to accept or decline the appointment request.'
  ].join('\n');
}

function buildApplicantReceivedEmail_(name) {
  return [
    'Hello ' + name + ',',
    '',
    'Thank you for applying to Consilium.',
    '',
    'We have successfully received your application. Your information is currently under review, and our team will get back to you shortly.',
    '',
    'Please note that your requested appointment time is not confirmed until you receive a separate confirmation from Consilium.',
    '',
    'We appreciate your interest.',
    '',
    'Consilium',
    'Strategy · Intelligence · Execution'
  ].join('\n');
}

function buildDecisionEmail_(name, reference, dateText, timeText, accepted) {
  if (accepted) {
    return [
      'Hello ' + name + ',',
      '',
      'Your Consilium application has been reviewed, and your requested appointment has been accepted.',
      '',
      'Application reference: ' + reference,
      'Appointment: ' + dateText + ' at ' + timeText + ' (' + TZ + ')',
      '',
      'Your appointment is now confirmed.',
      '',
      'We look forward to speaking with you.',
      '',
      'Consilium',
      'Strategy · Intelligence · Execution'
    ].join('\n');
  }

  return [
    'Hello ' + name + ',',
    '',
    'Thank you for your interest in Consilium.',
    '',
    'We have reviewed your application and are unable to accept the requested appointment at this time.',
    '',
    'Application reference: ' + reference,
    'Requested appointment: ' + dateText + ' at ' + timeText + ' (' + TZ + ')',
    '',
    'If you would like to discuss another opportunity to connect, please contact Consilium directly.',
    '',
    'Consilium',
    'Strategy · Intelligence · Execution'
  ].join('\n');
}

function first_(value) {
  return Array.isArray(value) ? value[0] : value;
}

function values_(value) {
  if (Array.isArray(value)) return value.map(function(v) { return clean_(v, 500); });
  return value == null || value === '' ? [] : [clean_(value, 500)];
}

function pad2_(n) {
  return String(n).padStart(2, '0');
}

function formatNow_() {
  return Utilities.formatDate(new Date(), TZ, 'yyyy-MM-dd HH:mm:ss');
}

function clean_(value, max) {
  return String(value == null ? '' : value)
    .replace(/[\u0000-\u001f\u007f]/g, ' ')
    .trim()
    .slice(0, max);
}

function json_(obj) {
  return ContentService
    .createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}

function responsePage_(ok, nonce, error, reference) {
  const data = JSON.stringify({
    type: 'consilium-submit-result',
    ok: !!ok,
    nonce: String(nonce || ''),
    error: String(error || ''),
    reference: String(reference || '')
  }).replace(/</g, '\\u003c');

  const html =
    '<!doctype html><html><body><script>' +
    'parent.postMessage(' + data + ', "*");' +
    '</script></body></html>';

  return HtmlService
    .createHtmlOutput(html)
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}
